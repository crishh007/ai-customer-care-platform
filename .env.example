# ==============================================================================
#            AI Customer Care Platform - Global Environment Template
# ==============================================================================
# Copy this file to a local '.env' file in each microservice folder or root
# as needed, and replace the placeholder values with actual credentials.
#
# WARNING: NEVER commit your local '.env' files with real keys to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# ------------------------------------------------------------------------------
# 2. AI & LLM Provider API Keys
# ------------------------------------------------------------------------------
# API Key for OpenAI services (GPT models, default embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# API Key for Groq services (Llama3, Mixtral high-performance hosting)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 3. ChromaDB Vector Store Configurations
# ------------------------------------------------------------------------------
# Folder path where local persistent ChromaDB sqlite database resides
CHROMA_DB_DIR=chroma_db

# Name of the default ChromaDB collection for vector support documents
CHROMA_COLLECTION_NAME=customer_care_docs

# Folder containing local raw text files to segment and ingest
DOCUMENT_DIR=data

# ChromaDB container connection details (used when running via docker-compose)
CHROMA_HOST=chroma
CHROMA_PORT=8000

# System path for ChromaDB storage inside containers
CHROMA_PATH=/app/chroma_db

# ------------------------------------------------------------------------------
# 4. Monitoring & Observability (LangSmith Tracing)
# ------------------------------------------------------------------------------
# Setting LANGCHAIN_TRACING_V2=true enables automatic LangSmith tracing on all
# LangChain LLM calls. Every prompt, response, latency, and token count will
# appear in the LangSmith dashboard automatically.
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=ai-customer-care

# ------------------------------------------------------------------------------
# 5. Database Connections (NoSQL & Cache)
# ------------------------------------------------------------------------------
# Connection string for primary metadata database (MongoDB)
MONGO_URI=mongodb://localhost:27017/customer_care

# Connection details for Redis cache and rate limiting
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 6. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing JWT login tokens (generate a long random string)
JWT_SECRET=your_jwt_secret_signing_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
